<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GcuCast</AssemblyName>
    <RootNamespace>GcuCast</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- MQTT / 遥测解析实现，位于 Shared/ 目录 -->
  <ItemGroup>
    <Compile Include="../GcuHud/GcuMqtt.cs" Link="Shared/GcuMqtt.cs" />
    <Compile Include="../GcuHud/Telemetry.cs" Link="Shared/Telemetry.cs" />
  </ItemGroup>

</Project>
